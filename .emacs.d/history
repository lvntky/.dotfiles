                    \"--header-insertion=never\"
                    \"--completion-style=detailed\")))
  :bind (:map eglot-mode-map
              (\"C-c e r\" . eglot-rename)
              (\"C-c e a\" . eglot-code-actions)
              (\"C-c e f\" . eglot-format-buffer)))

